# Environment credentials (CRITICAL: Protect private API keys)
.env
*.env
!.env.example

# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# Virtual Environments
venv/
.venv/
ENV/
env/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Local Raw & Processed Alternative Data Caches
data/raw/*.csv
data/raw/*.json
data/processed/*.json
data/processed/*.csv

# Keep directories tracked in git
!data/raw/.gitkeep
!data/processed/.gitkeep
!config/settings.yaml
!reports/.gitkeep
!reports/*.html
!reports/*.md

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
